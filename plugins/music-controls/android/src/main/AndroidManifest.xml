<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <application>
    <service android:name="com.ingageco.capacitormusiccontrols.MusicControlsNotificationKiller"
      android:stopWithTask="true" android:foregroundServiceType="mediaPlayback" />
    <!-- The message receiver is registered at runtime (registerReceiver) because
         it needs a plugin instance; a manifest-declared one would never work. -->
  </application>
</manifest>
